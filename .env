# Copy this file to .env and add your real keys locally.
# Do not commit .env to a public repository.
OPENAI_API_KEY=your_openai_api_key_here
# Optional Azure OpenAI settings for the compliance RAG concept.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your_model_deployment_name
# Optional vector database settings for future RAG expansion.
PINECONE_API_KEY=your_pinecone_api_key_here
CHROMA_DB_PATH=./chroma_db